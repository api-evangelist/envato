{
  "opencollection": "1.0.0",
  "info": {
    "name": "Envato Market Author Search API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search items in the marketplace catalog",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.envato.com/v1/discovery/search/search/item",
            "params": [
              {
                "name": "term",
                "value": "",
                "type": "query"
              },
              {
                "name": "site",
                "value": "",
                "type": "query"
              },
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search items in the marketplace catalog"
        }
      ]
    }
  ],
  "bundled": true
}